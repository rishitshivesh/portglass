{
  "name": "portglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "test:core": "node scripts/desktop.mjs test:core --lib",
    "build:desktop": "node scripts/desktop.mjs build --no-bundle",
    "format": "biome check --write .",
    "check": "biome check . --error-on-warnings",
    "format:rust": "node scripts/rustfmt.mjs",
    "check:rust": "node scripts/rustfmt.mjs --check",
    "format:docs": "prettier --write \"**/*.md\" \".github/**/*.yml\" \".vscode/*.json\" --ignore-path .gitignore",
    "test:frontend": "node --experimental-strip-types --test src/features/observations/snapshot-controller.test.ts src/features/agents/agent-status.test.ts src/features/dev-tools/classify.test.ts",
    "test:release": "node --test scripts/release/core.test.mjs",
    "release:verify": "node scripts/release/project.mjs verify",
    "release:version": "node scripts/release/project.mjs bump",
    "release:doctor": "node scripts/release/local.mjs doctor",
    "release:local": "node scripts/release/local.mjs build",
    "release:upload": "node scripts/release/github.mjs upload",
    "release:publish": "node scripts/release/github.mjs publish",
    "release:cask": "node scripts/release/github.mjs cask"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
